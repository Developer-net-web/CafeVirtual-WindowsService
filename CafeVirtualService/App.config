<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=SERVIDOR\SQLEXPRESS;Database=CafeVirtualDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>
    <add key="CarpetaEntrada"
         value="D:\tmp\Archivos\Entrada"/>

    <add key="CarpetaProcesados"
         value="D:\tmp\Archivos\Procesados"/>

    <add key="CarpetaErrores"
         value="D:\tmp\Archivos\Errores"/>

    <add key="Intervalo"
         value="30000"/>
  </appSettings>

</configuration>